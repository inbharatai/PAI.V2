# --- Rust / Cargo ---
target/
**/target/
**/*.rs.bk
*.pdb

# --- Node / frontend (Tauri desktop app) ---
**/node_modules/
apps/desktop/src/dist/
**/dist/
# Exception: the page-agent bundle is a byte-pinned release artifact (size +
# SHA-256 asserted by SecureBrowserPolicyHeadlessTest and the mobile golden
# hashes). It is vendored deliberately so a fresh clone reproduces the shipped
# secure-browser asset without `npm run bundle:android`.
!web-runtime/page-agent-unoone/dist/
!web-runtime/page-agent-unoone/dist/unoone-page-agent.js
# Only the byte-pinned .js is vendored; its source map is a build byproduct.
web-runtime/page-agent-unoone/dist/*.js.map
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri build artifacts ---
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# --- C/C++ (vendored Inbharat-audiocpp) ---
build/
**/build/
CMakeCache.txt
**/CMakeCache.txt
CMakeFiles/
**/CMakeFiles/
cmake_install.cmake
*.o
*.obj
*.so
*.dll
*.dylib
*.a
.cache/
**/.cache/

# --- Logs / local validation output ---
*.log
validation-local-*
validation-local*/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# --- Local secrets / env (never committed) ---
.env
.env.*
!.env.example
**/local.properties

# --- Screenshots / local media ---
screenshots/
*.local.png
# Claude Code session scratch space (fixtures, candidates)
.claude-scratch/
